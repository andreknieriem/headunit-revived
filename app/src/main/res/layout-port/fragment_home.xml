<?xml version="1.0" encoding="utf-8"?>
<!--
    Portrait-specific home layout.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_buttons_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/main_buttons_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintWidth_max="480dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <!-- Row 1: USB + WiFi -->
        <LinearLayout
            android:id="@+id/row1_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- USB cell -->
            <LinearLayout
                android:id="@+id/usb_cell"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/usb_button"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:elevation="6dp"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:backgroundTint="@null"
                        android:background="@drawable/gradient_orange"
                        app:iconGravity="textStart"
                        app:icon="@drawable/ic_usb_white"
                        app:iconTint="#ffffff"
                        app:iconSize="48dp"
                        app:iconPadding="0dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/usb_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/usb"
                    android:textColor="@color/text_primary"
                    android:shadowColor="@color/text_shadow"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="8"
                    android:textSize="15sp"
                    android:textFontWeight="700"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <!-- WiFi cell -->
            <LinearLayout
                android:id="@+id/wifi_cell"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/wifi_button"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:elevation="6dp"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:backgroundTint="@null"
                        android:background="@drawable/gradient_purple"
                        app:iconGravity="textStart"
                        app:icon="@drawable/ic_network_wifi_white"
                        app:iconTint="#ffffff"
                        app:iconSize="48dp"
                        app:iconPadding="0dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/wifi_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wifi"
                    android:textColor="@color/text_primary"
                    android:shadowColor="@color/text_shadow"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="8"
                    android:textSize="15sp"
                    android:textFontWeight="700"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Settings button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/settings_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp"
        android:text="@string/settings"
        app:icon="@drawable/ic_settings_white"
        app:iconTint="@android:color/white"
        app:backgroundTint="@color/material_grey_700"
        android:textColor="@android:color/white"
        app:cornerRadius="8dp" />

    <!-- Exit button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/exit_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"
        android:text="@string/exit"
        app:backgroundTint="@color/material_grey_700"
        android:textColor="@android:color/white"
        app:cornerRadius="8dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
